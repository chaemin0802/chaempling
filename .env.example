# Required: long random string for cookie/session signing
PAYLOAD_SECRET=replace-with-long-random-string

# SQLite location.
# Local dev:  file:./payload.db
# Railway:    file:/data/payload.db
DATABASE_URI=file:./payload.db

# Optional. Where local media uploads go when R2 is NOT configured.
# Ignored when R2_BUCKET is set.
MEDIA_DIR=media

# Cloudflare R2 (S3-compatible). When R2_BUCKET is set, uploads go to R2
# instead of the local disk and URLs point to R2_PUBLIC_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL prefix for served media (no trailing slash).
# Either the auto pub-xxxxx.r2.dev URL or your custom Cloudflare domain.
R2_PUBLIC_URL=
